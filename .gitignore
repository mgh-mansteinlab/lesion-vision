# Whole-slide archives are too large for git (typical NDPI 200–500 MB).
# One extracted punch lives in data/sample/.
*.ndpi
/data/*
!/data/DATA_ON_REQUEST.txt
!/data/sample/
!/data/sample/**

# Generated outputs
predictions/
logs/
experiments/logs/
experiments/model_eval/
experiments/benchmark/
experiments/task_difficulty/
experiments/analysis/
experiments/*.log
experiments/EXPERIMENT_LOG_APPEND.tsv
scripts/*.log
texput.log

# Manuscript and revision materials stay local
manuscript/

# Internal one-off analysis (not the public pipeline)
scripts/analysis/
src/fem_mushrooming/
src/radial_mushrooming_analyzer.py
compare_masks.py

